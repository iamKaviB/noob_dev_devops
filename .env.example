# Copy this file to .env:   cp .env.example .env
# Docker Compose automatically reads .env from the same folder as docker-compose.yml
# and substitutes ${VARIABLE} values in the YAML.
# Never commit your real .env — it holds passwords.

# Password for MySQL's "root" admin user
MYSQL_ROOT_PASSWORD=root_password

# Database + user the backend connects with (MySQL creates them on first start)
DB_NAME=messages_db
DB_USER=app
DB_PASSWORD=app_password
